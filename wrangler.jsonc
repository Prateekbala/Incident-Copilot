{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "incident-copilot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "ai": { "binding": "AI" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "incident-copilot",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "INCIDENT_AGENT", "class_name": "IncidentAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["IncidentAgent"] }],

  "workflows": [
    { "name": "investigation", "binding": "INVESTIGATION", "class_name": "InvestigationWorkflow" }
  ],

  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],

  "vars": {
    "AI_GATEWAY_ID": "",
    "PRIMARY_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "FALLBACK_MODEL": "@cf/meta/llama-3.1-8b-instruct",
    "WAIT_FOR_EFFECT": "30 seconds"
  }
}
